<odoo noupdate="1">


<record id="account_move_export_mail_template" model="mail.template">
    <field name="name">Journal Entry Export: Send by email</field>
    <field
            name="description"
        >Send the journal entry export to the external accounting firm</field>
    <field name="model_id" ref="account_move_export.model_account_move_export" />
    <field name="lang">{{ user.lang }}</field>
    <field name="auto_delete" eval="False" />
    <field
            name="email_from"
            >{{ user.email_formatted or object.company_id.email_formatted }}</field>
    <field name="use_default_to" eval="False"/>
    <field
            name="partner_to"
        >{{ ', '.join([str(p.id) for p in object.config_id.send_to_partner_ids]) }}</field>
    <field
            name="subject"
        >{{ object.company_id.name }} - Journal Entry Export {{ object.name }}</field>
    <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
    Please find enclosed the journal entries of the company <t
                        t-out="object.company_id.name"
                    >My Company</t> exported from Odoo. The file contains <t
                        t-out="object.move_count"
                    >5</t> journal entries (<t
                        t-out="object.move_line_count"
                    >14</t> journal items).
        <t t-if="object.date_end and not object.date_start">
            It integrates journal entries up to <t
                            t-out="format_date(object.date_end)"
                        >2024-09-05</t>.
        </t>
        <t t-if="object.date_end and object.date_start">
            It integrates journal entries from <t
                            t-out="format_date(object.date_start)"
                        >2024-08-01</t> to <t
                            t-out="format_date(object.date_end)"
                        >2024-08-31</t>.
        </t>
        <br /><br />
        Best Regards,
        <t t-if="not is_html_empty(user.signature)">
            <br /><br />
            <t t-out="user.signature">-- <br />Mitchell Admin</t>
        </t>
    </p>
</div>
    </field>
</record>


</odoo>
